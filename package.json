{
  "name": "@grinry/godot-mcp",
  "version": "0.1.2",
  "description": "MCP server for interfacing with Godot game engine. Provides tools for launching the editor, running projects, and capturing debug output.",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "cline",
    "codex"
  ],
  "homepage": "https://github.com/grinry/godot-mcp",
  "bugs": {
    "url": "https://github.com/grinry/godot-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grinry/godot-mcp.git"
  },
  "license": "MIT",
  "author": "grinry (https://github.com/grinry)",
  "type": "module",
  "bin": {
    "godot-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-metadata.js && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build && changeset publish",
    "format": "biome format --write .",
    "lint": "biome lint . --error-on-warnings",
    "check": "biome check . --error-on-warnings",
    "check:fix": "biome check --write . --error-on-warnings",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build:mcpb": "npm run build && node scripts/build-mcpb.js"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^2.31.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.14.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "contributors": [
    "Solomon Elias <solomon@sippy.ai>"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
